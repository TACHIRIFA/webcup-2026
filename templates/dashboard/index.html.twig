
{% extends 'dashboard/layout.html.twig' %}

{% block title %}
    TERRA NOVA - Tableau de bord
{% endblock %}

{% block dashboard_title %}
    Tableau de bord
{% endblock %}

{% block dashboard_description %}
    Bienvenue sur votre espace TERRA NOVA.
{% endblock %}

{% block dashboard_content %}

<section class="dashboard-section">

    <div class="dashboard-modules">

        <a
            href="{{ path('app_services') }}"
            class="dashboard-module"
        >
            <div>
                <h4>Annuaire des services</h4>

                <p>
                    Consultez les services municipaux et leurs informations utiles.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>
        </a>

        <a href="#actualites" class="dashboard-module">

            <div>
                <h4>Actualités & informations</h4>

                <p>
                    Retrouvez les annonces et informations pratiques de la municipalité.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>

        </a>

        <a href="#contact" class="dashboard-module">

            <div>
                <h4>Contacter la mairie</h4>

                <p>
                    Envoyez facilement vos demandes et messages à la mairie.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>

        </a>

        <a href="#profils" class="dashboard-module">

            <div>
                <h4>Gestion des profils</h4>

                <p>
                    Gérez les différents profils utilisateurs de la plateforme.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>

        </a>

        <a href="#permissions" class="dashboard-module">

            <div>
                <h4>Contrôle des accès</h4>

                <p>
                    Gérez les droits et les accès aux différentes fonctionnalités.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>

        </a>

        <a href="#agents" class="dashboard-module">

            <div>
                <h4>Espace agents</h4>

                <p>
                    Accédez à l'espace de travail destiné aux agents municipaux.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>

        </a>

        <a href="#demandes" class="dashboard-module">

            <div>
                <h4>Suivi des demandes</h4>

                <p>
                    Consultez et suivez l'état d'avancement des demandes.
                </p>
            </div>

            <span class="module-arrow">
                →
            </span>

        </a>

    </div>

</section>

{% endblock %}

