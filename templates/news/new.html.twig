{% extends 'dashboard/layout.html.twig' %}

{% block title %}
TERRA NOVA - Ajouter une actualité
{% endblock %}

{% block dashboard_title %}
Ajouter une actualité
{% endblock %}

{% block dashboard_description %}
Publiez une nouvelle actualité ou information municipale.
{% endblock %}

{% block dashboard_content %}

<section class="dashboard-section">

<div class="news-form-card">

    <h3
        id="news-form-title"
        class="news-form-title"
    >
        Nouvelle actualité
    </h3>

    {{ form_start(form, {
        'attr': {
            'class': 'news-form',
            'aria-labelledby': 'news-form-title'
        }
    }) }}

        <div class="news-form-grid">

            <div class="form-field form-field-full">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="form-field">
                {{ form_label(form.category) }}
                {{ form_widget(form.category) }}
                {{ form_errors(form.category) }}
            </div>

            <div class="form-field">
                {{ form_label(form.publishAt) }}
                {{ form_widget(form.publishAt) }}
                {{ form_errors(form.publishAt) }}
            </div>

            <div class="form-field form-field-full">
                {{ form_label(form.content) }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>

            <div class="form-field form-field-full">
                {{ form_label(form.image) }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>

        </div>

        <div class="news-form-actions">

            <a
                href="{{ path('app_news') }}"
                class="news-cancel-button"
            >
                Annuler
            </a>

            <button
                type="submit"
                class="news-submit-button"
            >
                Publier l’actualité
            </button>

        </div>

    {{ form_end(form) }}

</div>

</section>

{% endblock %}
